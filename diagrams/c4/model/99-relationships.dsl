# People
owner -> matrix "Talks to keepers in product spaces"
owner -> platform.trust "Signs mandates, grants and authoritative envelopes" "mandate CLI"
operator -> platform.launcher "Launches keepers and orchestrators" "curator run"
operator -> platform.sessionHost.supervisor "Lists, parks, restarts; R55 binary swap in the maintenance slot" "CLI (signed control)"
operator -> platform.sessionHost.holder "Attaches with an exclusive input lease" "terminal.raw grant"
owner -> platform.board "Confirms flow versions, acts in human-owned states" "task-board trust confirm"

# Launcher (thin client) and composer
platform.launcher -> platform.composer "Asks for one plan (compose-only); compares expect_pin" "curator-run, launch intent"
platform.composer -> platform.environment "Resolves the role profile (sole fragment reader)" "env resolve JSON"
platform.launcher -> platform.modelRouter "Routes model and effort" "route()"
platform.launcher -> platform.networkProfiles "Resolves egress profile" "resolve()"
platform.launcher -> platform.providerLimits "Slot and per-host gates" "admit_host()"
platform.launcher -> platform.registry "Reads the versioned project binding" "binding()"
platform.launcher -> platform.sessionHost.supervisor "Hands the composed plan to intake; drives initialize" "ax start --launch-plan contract"
platform.launcher -> platform.remoteHarness "Sends a launch intent with profile_pin and binding pin" "rwh"
platform.launcher -> platform.bridge.bridgeCore "Binds I/O providers at initialize" "bind()"
platform.launcher -> platform.trust "Consumes mandate for privileged steps" "mandate consume"

# Session host internals
platform.sessionHost.supervisor -> platform.sessionHost.admission "Every typed mutation; fence changes" "admit(), fence"
platform.sessionHost.supervisor -> platform.sessionHost.holder "Starts, stops, confirms absence" "controller epoch"
platform.sessionHost.supervisor -> platform.composer "Compare-only pin answer on resume; new plan only for rebuild" "compose-only"
platform.sessionHost.supervisor -> platform.sessionHost.contextEngine "Export, seed, reconcile unknown deliveries (opaque refs only)" "Go API"
platform.sessionHost.supervisor -> platform.providerLimits "Rechecks gates before exec; holds the transferred lease" "admit_host/release"
platform.sessionHost.admission -> platform.trust "Re-verifies grants and revocation at enqueue and dispatch" "verify/granted"
platform.sessionHost.admission -> platform.sessionHost.journal "Persists fences and the durable inbox" "fsync"
platform.sessionHost.contextEngine -> platform.sessionHost.admission "Dispatches only admitted items while the fence is open" "admit()"
platform.sessionHost.contextEngine -> platform.sessionHost.adapters "Writes input, reads events" "dispatch/observe"
platform.sessionHost.contextEngine -> platform.sessionHost.journal "Appends events, stores packages and source material" "append"
platform.sessionHost.adapters -> platform.sessionHost.holder "Turn input and output" "framed pipes / PTY"
platform.sessionHost.holder -> platform.harness "Execs and holds the process" "process group"
platform.sessionHost.goalLedger -> platform.sessionHost.journal "Stores goals and delivery records" "CAS"
platform.registry -> platform.sessionHost.supervisor "Requests restore after reboot (only automatic requester)" "up() -> resume()"

# Bridge internals
platform.bridge.bridgeCore -> platform.bridge.trustGate "Checks every inbound envelope" "verify()"
platform.bridge.trustGate -> platform.trust "Verifies signatures, grants, mandates" "verify/granted"
platform.bridge.bridgeCore -> platform.bridge.bridgeStore "Atomic id claim and admission record; outbox; audit" "local transaction"
platform.bridge.bridgeCore -> platform.sessionHost.admission "Durable idempotent enqueue; acceptance after host ack" "enqueue(idem_key)"
platform.bridge.bridgeCore -> platform.sessionHost.contextEngine "Observes projected output, receipts" "observe()"
platform.bridge.bridgeCore -> platform.sessionHost.goalLedger "Goal calls on behalf of tails and the goal provider" "goal.* (typed)"
platform.bridge.bridgeCore -> platform.bridge.pluginApi "Runs provider processes through" "JSONL"
platform.bridge.pluginApi -> platform.bridge.matrixProvider "bind/output/receipt" "swarm-plugin/1"
platform.bridge.pluginApi -> platform.bridge.goalProvider "bind/output/receipt" "swarm-plugin/1"
platform.bridge.pluginApi -> platform.bridge.terminalProvider "bind/output" "swarm-plugin/1"
platform.bridge.tails -> platform.bridge.bridgeCore "goal, park, post, inbox read" "unix socket + session token"
platform.harness -> platform.bridge.tails "Agent runs tail commands" "shell tool"
platform.bridge.matrixProvider -> matrix "Subscribes and posts" "a2a / Matrix CS API"
platform.bridge.goalProvider -> platform.providerLimits "Checks nudge budget" "acquire()"

# Harness and remote
platform.harness -> modelProviders "Model calls" "HTTPS"
platform.harness -> git "Works in project repo" "git"
platform.remoteHarness -> remoteHost "Target curator-run composes and refuses on pin mismatch; harness turns" "ssh + unix sockets"
platform.remoteHarness -> platform.workerJail "Runs tool calls" "worker-jail run"
platform.remoteHarness -> platform.sessionHost.adapters "Relays turns and output" "adapter over rwh"
platform.workerJail -> git "Seeds from the exact base SHA, exports patch" "git bundle"
remoteHost -> modelProviders "Model calls on remote subscriptions" "HTTPS"
platform.modelRouter -> modelProviders "Knows provider capabilities" "catalog"

# Board (B1-B6)
platform.board.flowEngine -> git "Reads Playbook.json at the default-branch head" "git"
platform.board.flowEngine -> platform.environment "Validates and resolves the closure and role skills" "curator playbook check"
platform.board.flowEngine -> platform.board.kernelGuards "Narrow-checks the resolved closure against kernel-policy/1" "narrow_check()"
platform.board.flowEngine -> platform.trust "Asks whether a version is confirmed or covered" "confirmed/granted/narrowed"
platform.board.flowEngine -> platform.board.taskStore "Commits proposals with expected rev and generation" "write_status(proposal)"
platform.board.taskStore -> platform.board.kernelGuards "Checks K1-K8 in the same transaction" "kguard()"
platform.board.flowEngine -> platform.board.deliveryModule "Evaluates module guards and actions" "guard/action/event"
platform.board.deliveryModule -> platform.board.kernelGuards "CR, integrate and land go through kernel operations" "cr.*/integrate/land"
platform.board.flowEngine -> platform.board.roleRouter "Entered a state with spawn.owner" "flow.entered"
platform.board.roleRouter -> platform.registry "Reads role bindings, pins and slots" "binding()"
platform.board.roleRouter -> platform.board.spawn "Agent owner: LaunchRequest" "spawn()"
platform.board.roleRouter -> platform.board.goalBinding "Standing owner or human owner: goal revision or notice" "publish()"
platform.board.spawn -> platform.launcher "Launches the role with the spawn key" "launch(LaunchRequest)"
platform.board.spawn -> platform.board.taskStore "Attaches RUN-* by reconciliation" "attach()"
platform.board.goalBinding -> platform.bridge.pluginApi "Publishes goal revisions, receives outcome proposals" "swarm-plugin/1"
platform.board.goalBinding -> platform.board.flowEngine "Done proposal: transition request" "propose(actor=run)"
platform.board.goalBinding -> platform.board.taskStore "Goal revisions with handoff refs; notices" "goal.revise/append"
platform.board.deliveryModule -> platform.board.limitsClient "Queues check sets" "queue()"
platform.board.limitsClient -> platform.providerLimits "Slots, gates and validation FIFO" "acquire/queue"
platform.board.kernelGuards -> git "Integrates accepted revisions (signed exact-head ff)" "git"
