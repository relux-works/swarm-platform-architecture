@startuml context-takeover
!theme plain
title Context takeover: crash or reboot -> fence -> confirmed absence -> eligibility -> seed or native resume -> reconcile -> release

participant "Product registry\n(S4 keeper up)" as Reg
participant "Session host\n(M1 supervisor)" as SH
database "Host store\n(fences, journal,\nprotected source)" as HS
participant "Composer\n(curator-run)" as C
participant "Context Engine\n(M2, host package)" as CE
participant "Bridge\n(M3)" as BR
participant "Matrix provider" as MP
participant "Old holder +\nharness" as H1
participant "New holder +\nharness" as H2

alt harness crash
  H1 -> SH: process exited (non-zero)
  SH -> HS: fence.close(op_id, reason=crash), fsync
  SH -> SH: confirm absence: process group empty,\nnative session lock released
  SH -> CE: export(restore projection, audience=same_session)
  CE -> HS: HandoffPackage at watermark H\n(refs into protected source, per-item provenance)
else host reboot
  SH -> HS: read every fence first; boot_id changed = absence evidence
  SH -> SH: sessions awaiting_restore (explicit stops stay stopped)
  Reg -> SH: up(): request restore per registered session
  SH -> HS: last committed package per session
end

alt absence not confirmed
  SH -> BR: notice stop_unconfirmed; fence stays closed
else absent
  SH -> C: compare-only (profile_pin, fragment digest on the same host)
  C --> SH: current digests
  SH -> SH: compare pins and posture; binding rev; grants;\nauth readiness; runtime resume probe; goal revision current
  alt drift or any check fails
    SH -> HS: parked_refused{reason}; fence stays closed
    SH -> BR: notice refused{reason}: operator decides (accepting drift = new operation, rebuild)
    note over SH, H2
      The restore path ends here: no rebind,
      no replay, no "restored" notice.
    end note
  else eligible
    SH -> H2: exec stored plan, new generation
    alt native_resume allowed (same runtime range, home, pin, transcript digest, exclusive custody)
      CE -> H2: native resume (native_session_ref)
    else takeover across profile or runtime
      CE -> CE: seed import: re-authorize audience, pins,\ngoal revisions, every item by its verdict
      alt seed check fails
        SH -> H2: compensate: stop, confirm absence
        SH -> BR: notice refused{seed}; fence stays closed
      else seed ok
        CE -> H2: first framed turn (host_authored frame;\nitems keep their own verdict labels)
      end
    end
    SH -> CE: reconcile unknown deliveries (input markers in transcript)
    CE -> CE: applied / not_applied / unknown;\napprovals and control never replayed
    SH -> BR: rebind io_bindings (same handles, binding rev rechecked)
    BR -> MP: bind{binding_handle}
    MP -> BR: envelopes after its own cursor
    BR -> BR: id claims: duplicates return the old receipt
    BR -> SH: enqueue(idem_key) for new items
    SH -> HS: fence.open(op_id), fsync
    CE -> H2: dispatch queued items in order
    opt goal active
      BR -> SH: goal provider nudges resume via enqueue (goal ledger revision)
    end
    SH -> BR: notice session.restored (fidelity, lost items)
    BR -> MP: post "restored" to #X-system
  end
end
@enduml
