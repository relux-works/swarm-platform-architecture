@startuml keeper-start
!theme plain
title Product keeper start (thin launcher + composer + session manager intake + context bridge with a Matrix provider)

actor "Operator" as Op
participant "Launcher\n(thin client)" as L
participant "Composer\n(curator-run)" as C
participant "Environment\n(Curator)" as Env
participant "Product registry" as Reg
participant "Provider limits" as Lim
participant "Session manager" as SM
participant "Context manager" as CM
participant "Context bridge" as BR
participant "Matrix provider" as MP
participant "Goal provider" as GP
participant "Harness\n(X_keeper)" as H
database "Matrix (a2a)" as MX

Op -> L: swarm launch ~--profile product-keeper\n~--project X ~--mode interactive
L -> Reg: binding(X)
Reg --> L: product dir, rooms #X-lobby #X-broadcast #X-system
L -> Lim: acquire(provider slot)
Lim --> L: lease
L -> C: compose-only(profile product-keeper, interactive)
C -> Env: env resolve <env> ~--profile product-keeper ~--format json
Env --> C: launch-env fragment (tool home, lock_sha256,\ninstructions, skills, MCP, command_environment)
note right of Env
  Tool home only (CLAUDE_CONFIG_DIR /
  CODEX_HOME / XDG); HOME kept.
  Claude: one /login per managed home,
  or CIP-0003 token once adopted
end note
C -> C: agents-management plan\n(one construction site)
C --> L: plan + lock_sha256 + fragment digest
L -> SM: ax start X_keeper ~--launch-plan - (policy=always-restart)
SM -> H: exec under holder
SM -> CM: channel(session) granted
CM -> H: open adapter (stream-json / app-server)
SM --> L: session_id

== I/O bindings ==
L -> BR: bind(session, matrix, rooms X-*)
BR -> MP: bind{binding_id, config, secret_ref}
opt identity X_keeper does not exist yet
  L -> L: mandate consume (identity ensure)
  MP -> MX: identity ensure (under mandate)
end
MP -> MX: join and subscribe rooms
MP --> BR: manifest + cursor
L -> BR: bind(session, goal)
BR -> GP: bind{binding_id}

opt a handoff package exists for X_keeper
  alt same runtime, same managed home, same lock_sha256 + fragment digest
    L -> CM: restore(handoff, session, preserve)
    CM -> H: native resume, replay undelivered envelopes
  else pin or home differs
    L -> CM: restore(handoff, session, rebuild)
    CM -> H: first framed turn: summary + goal + open items
  end
end

L --> Op: session_id, attach hint
@enduml
