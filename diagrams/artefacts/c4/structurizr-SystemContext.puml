@startuml
title <size:24>System Context View: Swarm Platform</size>\n<size:24>The swarm platform, its people and external systems</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
</style>

person "==Owner\n<size:16>[Person]</size>\n\nSets direction, signs mandates, talks to keepers in product spaces" <<Element-RWxlbWVudCxQZXJzb24=>> as Owner
person "==Co-founder / operator\n<size:16>[Person]</size>\n\nRuns nodes, reviews architecture, attaches to sessions" <<Element-RWxlbWVudCxQZXJzb24=>> as Cofounderoperator
rectangle "==Swarm Platform\n<size:16>[Software System]</size>\n\nHolds agent sessions, wraps their I/O, launches local and remote agents" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as SwarmPlatform
rectangle "==Matrix Homeserver (a2a)\n<size:16>[Software System]</size>\n\nSpaces, rooms and threads; a2a mailbox and identities" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as MatrixHomeservera2a
rectangle "==Model Providers\n<size:16>[Software System]</size>\n\nAnthropic, OpenAI, local inference-manager endpoints" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as ModelProviders
rectangle "==Remote Host\n<size:16>[Software System]</size>\n\nMac mini with subscriptions, runs the remote harness side" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as RemoteHost
rectangle "==Git Repositories\n<size:16>[Software System]</size>\n\nOne repo per project" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as GitRepositories

SwarmPlatform --> MatrixHomeservera2a <<Relationship-UmVsYXRpb25zaGlw>> : "Subscribes and posts\n<size:16>[a2a / Matrix CS API]</size>"
SwarmPlatform --> ModelProviders <<Relationship-UmVsYXRpb25zaGlw>> : "Model calls\n<size:16>[HTTPS]</size>"
SwarmPlatform --> GitRepositories <<Relationship-UmVsYXRpb25zaGlw>> : "Works in project repo\n<size:16>[git]</size>"
SwarmPlatform --> RemoteHost <<Relationship-UmVsYXRpb25zaGlw>> : "Target curator-run composes and refuses on pin mismatch; harness turns\n<size:16>[ssh + unix sockets]</size>"
RemoteHost --> ModelProviders <<Relationship-UmVsYXRpb25zaGlw>> : "Model calls on remote subscriptions\n<size:16>[HTTPS]</size>"
SwarmPlatform --> Owner <<Relationship-UmVsYXRpb25zaGlw>> : "Relays the vendor's re-login flow and lease approvals\n<size:16>[phone confirmation]</size>"
Owner --> MatrixHomeservera2a <<Relationship-UmVsYXRpb25zaGlw>> : "Talks to keepers in product spaces"
Owner --> SwarmPlatform <<Relationship-UmVsYXRpb25zaGlw>> : "Signs mandates, grants and authoritative envelopes\n<size:16>[mandate CLI]</size>"
Cofounderoperator --> SwarmPlatform <<Relationship-UmVsYXRpb25zaGlw>> : "Launches keepers and orchestrators\n<size:16>[curator run]</size>"

@enduml