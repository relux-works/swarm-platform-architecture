person "==Co-founder / operator\n<size:16>[Person]</size>\n\nRuns nodes, reviews architecture, attaches to sessions" <<Element-RWxlbWVudCxQZXJzb24=>> as Cofounderoperator

rectangle "Swarm Platform\n<size:16>[Software System]</size>" <<Boundary-U3dhcm0gUGxhdGZvcm0=>> {
  rectangle "Session Host (M1 + M2)\n<size:16>[Container: agent-session-host (Phase-0 baseline: tb-sessiond)]</size>" <<Boundary-U2Vzc2lvbiBIb3N0IChNMSArIE0yKQ==>> {
    rectangle "==Context Engine (M2)\n<size:16>[Component: Go package]</size>\n\nDispatcher (the only stdin writer), delivery evidence, interactions, export/seed of swarm-handoff/2, resolve_ref, egress projections" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.ContextEngineM2
    rectangle "==Harness Adapters\n<size:16>[Component: Go package]</size>\n\nclaude-stream-json, codex-app-server, muse-serve (hosted-stream/1), pty-preserve; readiness grammar pinned per release; unknown parks" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.HarnessAdapters
    rectangle "==Goal Ledger\n<size:16>[Component: Go package]</size>\n\nCaller-authored initial goals (D-GOALS; CAS and budgets) and delivery records for board revisions; agent self-goals deferred to SH2+ G2" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.GoalLedger
    database "==Host Store\n<size:16>[Component: Files, append-only, owner-only]</size>\n\nJournal, durable inbox, fences, plans, protected source storage (transcripts, tool outputs, patches)" <<Element-RWxlbWVudCxDb21wb25lbnQsU3RvcmU=>> as SwarmPlatform.SessionHostM1M2.HostStore
    rectangle "==Supervisor (M1)\n<size:16>[Component: Go]</size>\n\nPlan intake (ax start --launch-plan contract, strict mode), session/execution registry, controller epochs, restart, resume, takeover, reconciliation; no broker client or credential lookup" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.SupervisorM1
    rectangle "==Admission and Fences\n<size:16>[Component: Go]</size>\n\nadmit() at every typed mutation; persisted admission fence open/closed/update_lock; durable idempotent enqueue (ack after fsync)" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.AdmissionandFences
    rectangle "==Execution Holder\n<size:16>[Component: Go process]</size>\n\nAgent-side executor/holder under the bound agent UID: first curator-run, later swarma-session-runner sharing its launch library; verifies supplied plan, protected credential lookup and fresh broker connection after UID drop; native process, PTY or framed pipes, exclusive input lease; no goal, board, carrier or journal semantics; intake and SH2+ activation gated" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as SwarmPlatform.SessionHostM1M2.ExecutionHolder
  }

  person "==Agent Harness Session\n<size:16>[Container: Native CLI]</size>\n\nClaude Code, Codex, Muse or Pi process in a Curator managed tool home (HOME kept)" <<Element-RWxlbWVudCxDb250YWluZXIsSGFybmVzcw==>> as SwarmPlatform.AgentHarnessSession
  rectangle "==Bridge (M3)\n<size:16>[Container: agent-session-bridge]</size>\n\nHosts provider processes; trust gate; durable bridge-local admission; host enqueue; audience-checked outbox; tails" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.BridgeM3
  rectangle "==Trust\n<size:16>[Container: mandate CLI + library]</size>\n\ncurator-trust + mandates: exact-byte verification, grants with attenuation-only delegation, revocation snapshots, capability tokens; assurance mode T today, mode S through OS-user isolation (v1.3)" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.Trust
  rectangle "==Remote Executor\n<size:16>[Container: rwh]</size>\n\nRuns a harness on another host from a pin-carrying launch intent; tools run in the remote workplace on this host; returns the accepted pin and plan digest" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.RemoteExecutor
  rectangle "==Credential Broker\n<size:16>[Container: privileged daemon]</size>\n\nHolds long-lived provider logins; hands each launch what its harness consumes (node-backed token in env or API key through the admitted helper mode; material only to the admitted agent-side executor/holder after UID transition); tracks expiry; relays the vendor's own re-login flow to the operator's phone" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.CredentialBroker
  rectangle "==Agent Workplace\n<size:16>[Container: OS user + kernel firewall]</size>\n\nOne OS user per autonomous agent: private home (0700, no parent ACL), kernel firewall admitting only the message broker and the egress proxy; created and removed by the dispatcher's helper; the unit of mode S" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.AgentWorkplace
  rectangle "==Capacity (S3)\n<size:16>[Container: extracted from task-board]</size>\n\nSlots, per-host gates (disk, CPU idle, build lock, syspolicyd), lease transfer, validation FIFO (board part B6)" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.CapacityS3
  rectangle "==Product Registry / Keeper\n<size:16>[Container: curator-keeper registry]</size>\n\nProducts, projects, versioned project bindings (hosts, base, remote workplace, egress, rooms, role bindings with slots, team), up after reboot" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.ProductRegistryKeeper
  rectangle "==Launcher (thin client)\n<size:16>[Container: curator run (canonical) / swarm launch (optional wrapper)]</size>\n\nLaunch transaction: prepare, capacity, compose, compare expect_pin, admit, start, initialize, ready, with compensation. Never reads a fragment or store content, spells a flag, execs or holds" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.Launcherthinclient
  rectangle "==Composer\n<size:16>[Container: curator-run + agents-management (one construction site)]</size>\n\nThe only composer and fragment reader: resolves the role profile, builds one Decision 0013 plan (interactive, headless, hosted-stream with session-start permission frames); compose-only and compare-only answers" <<Element-RWxlbWVudCxDb250YWluZXI=>> as SwarmPlatform.Composer
}

SwarmPlatform.BridgeM3 --> SwarmPlatform.SessionHostM1M2.ContextEngineM2 <<Relationship-UmVsYXRpb25zaGlw>> : "Observes projected output, receipts\n<size:16>[observe()]</size>"
SwarmPlatform.BridgeM3 --> SwarmPlatform.SessionHostM1M2.GoalLedger <<Relationship-UmVsYXRpb25zaGlw>> : "Caller/board-authored goals and scheduler delivery; no agent goal capability (session host §3.8)\n<size:16>[goal-client surface unpublished]</size>"
SwarmPlatform.AgentHarnessSession --> SwarmPlatform.BridgeM3 <<Relationship-UmVsYXRpb25zaGlw>> : "Agent runs tail commands\n<size:16>[shell tool]</size>"
SwarmPlatform.BridgeM3 --> SwarmPlatform.CapacityS3 <<Relationship-UmVsYXRpb25zaGlw>> : "Checks nudge budget\n<size:16>[acquire()]</size>"
SwarmPlatform.RemoteExecutor --> SwarmPlatform.SessionHostM1M2.HarnessAdapters <<Relationship-UmVsYXRpb25zaGlw>> : "Relays turns and output\n<size:16>[adapter over rwh]</size>"
SwarmPlatform.SessionHostM1M2.ExecutionHolder --> SwarmPlatform.AgentWorkplace <<Relationship-UmVsYXRpb25zaGlw>> : "Runs under the agent's OS user; started by the privileged launcher via the dispatcher\n<size:16>[agent-side executor/holder]</size>"
SwarmPlatform.SessionHostM1M2.ExecutionHolder --> SwarmPlatform.CredentialBroker <<Relationship-UmVsYXRpb25zaGlw>> : "Re-resolves protected binding; receives admitted lease material after UID transition\n<size:16>[fresh Unix socket, bound agent peer UID]</size>"
Cofounderoperator --> SwarmPlatform.Launcherthinclient <<Relationship-UmVsYXRpb25zaGlw>> : "Launches keepers and orchestrators\n<size:16>[curator run]</size>"
Cofounderoperator --> SwarmPlatform.SessionHostM1M2.SupervisorM1 <<Relationship-UmVsYXRpb25zaGlw>> : "Lists, parks, restarts; R55 binary swap in the maintenance slot\n<size:16>[CLI (signed control)]</size>"
Cofounderoperator --> SwarmPlatform.SessionHostM1M2.ExecutionHolder <<Relationship-UmVsYXRpb25zaGlw>> : "Attaches with an exclusive input lease\n<size:16>[terminal.raw grant]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.Composer <<Relationship-UmVsYXRpb25zaGlw>> : "Asks for one plan (compose-only); compares expect_pin\n<size:16>[curator-run, launch intent]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.CapacityS3 <<Relationship-UmVsYXRpb25zaGlw>> : "Slot and per-host gates\n<size:16>[admit_host()]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.ProductRegistryKeeper <<Relationship-UmVsYXRpb25zaGlw>> : "Reads the versioned project binding\n<size:16>[binding()]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.SessionHostM1M2.SupervisorM1 <<Relationship-UmVsYXRpb25zaGlw>> : "Hands the composed plan to intake; drives initialize\n<size:16>[ax start --launch-plan contract]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.RemoteExecutor <<Relationship-UmVsYXRpb25zaGlw>> : "Sends a launch intent with profile_pin and binding pin\n<size:16>[rwh]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.BridgeM3 <<Relationship-UmVsYXRpb25zaGlw>> : "Binds I/O providers at initialize\n<size:16>[bind()]</size>"
SwarmPlatform.Launcherthinclient --> SwarmPlatform.Trust <<Relationship-UmVsYXRpb25zaGlw>> : "Consumes mandate for privileged steps\n<size:16>[mandate consume]</size>"
SwarmPlatform.SessionHostM1M2.SupervisorM1 --> SwarmPlatform.SessionHostM1M2.AdmissionandFences <<Relationship-UmVsYXRpb25zaGlw>> : "Every typed mutation; fence changes\n<size:16>[admit(), fence]</size>"
SwarmPlatform.SessionHostM1M2.SupervisorM1 --> SwarmPlatform.SessionHostM1M2.ExecutionHolder <<Relationship-UmVsYXRpb25zaGlw>> : "Fences and controls the current registered runner; start/stop via dispatcher\n<size:16>[controller epoch]</size>"
SwarmPlatform.SessionHostM1M2.SupervisorM1 --> SwarmPlatform.Composer <<Relationship-UmVsYXRpb25zaGlw>> : "Compare-only pin answer on resume; new plan only for rebuild\n<size:16>[compose-only]</size>"
SwarmPlatform.SessionHostM1M2.SupervisorM1 --> SwarmPlatform.SessionHostM1M2.ContextEngineM2 <<Relationship-UmVsYXRpb25zaGlw>> : "Export, seed, reconcile unknown deliveries (opaque refs only)\n<size:16>[Go API]</size>"
SwarmPlatform.SessionHostM1M2.SupervisorM1 --> SwarmPlatform.CapacityS3 <<Relationship-UmVsYXRpb25zaGlw>> : "Rechecks gates before requesting dispatcher start; holds lease until confirmed absence\n<size:16>[admit_host/release]</size>"
SwarmPlatform.SessionHostM1M2.AdmissionandFences --> SwarmPlatform.Trust <<Relationship-UmVsYXRpb25zaGlw>> : "Re-verifies grants and revocation at enqueue and dispatch\n<size:16>[verify/granted]</size>"
SwarmPlatform.SessionHostM1M2.AdmissionandFences --> SwarmPlatform.SessionHostM1M2.HostStore <<Relationship-UmVsYXRpb25zaGlw>> : "Persists fences and the durable inbox\n<size:16>[fsync]</size>"
SwarmPlatform.SessionHostM1M2.ContextEngineM2 --> SwarmPlatform.SessionHostM1M2.AdmissionandFences <<Relationship-UmVsYXRpb25zaGlw>> : "Dispatches only admitted items while the fence is open\n<size:16>[admit()]</size>"
SwarmPlatform.SessionHostM1M2.ContextEngineM2 --> SwarmPlatform.SessionHostM1M2.HarnessAdapters <<Relationship-UmVsYXRpb25zaGlw>> : "Writes input, reads events\n<size:16>[dispatch/observe]</size>"
SwarmPlatform.SessionHostM1M2.ContextEngineM2 --> SwarmPlatform.SessionHostM1M2.HostStore <<Relationship-UmVsYXRpb25zaGlw>> : "Appends events, stores packages and source material\n<size:16>[append]</size>"
SwarmPlatform.SessionHostM1M2.HarnessAdapters --> SwarmPlatform.SessionHostM1M2.ExecutionHolder <<Relationship-UmVsYXRpb25zaGlw>> : "Turn input and output\n<size:16>[framed pipes / PTY]</size>"
SwarmPlatform.SessionHostM1M2.ExecutionHolder --> SwarmPlatform.AgentHarnessSession <<Relationship-UmVsYXRpb25zaGlw>> : "Execs and holds the process\n<size:16>[process group]</size>"
SwarmPlatform.SessionHostM1M2.GoalLedger --> SwarmPlatform.SessionHostM1M2.HostStore <<Relationship-UmVsYXRpb25zaGlw>> : "Stores goals and delivery records\n<size:16>[CAS]</size>"
SwarmPlatform.ProductRegistryKeeper --> SwarmPlatform.SessionHostM1M2.SupervisorM1 <<Relationship-UmVsYXRpb25zaGlw>> : "Illustrative reboot requester proposal; host vs registry remains open\n<size:16>[up() -> resume()]</size>"
SwarmPlatform.BridgeM3 --> SwarmPlatform.Trust <<Relationship-UmVsYXRpb25zaGlw>> : "Verifies signatures, grants, mandates\n<size:16>[verify/granted]</size>"
SwarmPlatform.BridgeM3 --> SwarmPlatform.SessionHostM1M2.AdmissionandFences <<Relationship-UmVsYXRpb25zaGlw>> : "Durable idempotent enqueue; acceptance after host ack\n<size:16>[enqueue(idem_key)]</size>"

@enduml