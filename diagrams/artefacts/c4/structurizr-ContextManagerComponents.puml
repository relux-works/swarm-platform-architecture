@startuml
title <size:24>Component View: Swarm Platform - Context Manager and Bridge</size>\n<size:24>Context manager internals: manager, bridge, trust gate, provider plugins</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(MatrixHomeservera2a, "Matrix Homeserver (a2a)", $descr="Spaces, rooms and threads; a2a mailbox and identities", $tags="", $link="")

System_Boundary("SwarmPlatform_boundary", "Swarm Platform", $tags="") {
  Container_Boundary("SwarmPlatform.ContextManagerandBridge_boundary", "Context Manager and Bridge", $tags="") {
    Component(SwarmPlatform.ContextManagerandBridge.ContextBridge, "Context Bridge", $techn="Go process", $descr="Plugin host: binds providers to sessions, routes envelopes and output, serves tails", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.TrustGate, "Trust Gate", $techn="Go", $descr="Signature, pinned identity, grant/mandate scope, freshness, deterministic checks; frames untrusted input", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, "Provider Plugin Interface", $techn="JSONL over stdio", $descr="describe, bind, unbind, output, tail, receipt / manifest, envelope, cursor, health", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.TailsCLI, "Tails CLI", $techn="CLI", $descr="swarm-tail goal set/clear/status, post, park; per-session capability token", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.MatrixProvider, "Matrix Provider", $techn="Plugin over a2a", $descr="Subscribes to rooms/threads, emits envelopes, posts output", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.GoalProvider, "Goal Provider", $techn="Plugin", $descr="Smart Ralph loop: nudges via stdin until done, blocked or exhausted", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.TerminalProvider, "Terminal Provider", $techn="Plugin", $descr="Human attach and watch", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.BoardProviderfuture, "Board Provider (future)", $techn="Plugin", $descr="Placeholder: goals and spawn intents from a flow plugin", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.ContextManagerCore, "Context Manager Core", $techn="Go", $descr="open, inject, observe, snapshot, restore, slice", $tags="", $link="")
    Component(SwarmPlatform.ContextManagerandBridge.HarnessAdapters, "Harness Adapters", $techn="Go", $descr="claude-stream-json, codex-app-server, muse-serve, pty-preserve; turn-state detection, unknown parks", $tags="", $link="")
    ComponentDb(SwarmPlatform.ContextManagerandBridge.JournalandContextStore, "Journal and Context Store", $techn="Files, append-only", $descr="Normalized events, goal state, handoff packages (swarm-handoff/0)", $tags="", $link="")
  }

  Container(SwarmPlatform.AgentHarnessSession, "Agent Harness Session", $techn="Native CLI", $descr="Claude Code, Codex, Muse or Pi process with a relocated tool home", $tags="", $link="")
  Container(SwarmPlatform.Trust, "Trust", $techn="mandate CLI + library", $descr="Mandates, curator-trust grants, capability tokens", $tags="", $link="")
  Container(SwarmPlatform.RemoteHarness, "Remote Harness", $techn="rwh", $descr="Runs a harness on another host, tools local and jailed", $tags="", $link="")
  Container(SwarmPlatform.ProviderLimits, "Provider Limits", $techn="extracted from task-board", $descr="Host semaphore, rate limits, validation FIFO", $tags="", $link="")
  Container(SwarmPlatform.Launcher, "Launcher", $techn="Go CLI (swarm launch) over Curator + agents-management", $descr="Turns a LaunchRequest into a running session: manifest, tool home, model route, limits slot, one plan, local or remote target", $tags="", $link="")
  Container(SwarmPlatform.SessionManager, "Session Manager", $techn="agent-session-host core (now: tb-sessiond)", $descr="Holds harness processes alive: start, stop, park, restart, reboot restore; no content", $tags="", $link="")
}

Rel(SwarmPlatform.Launcher, SwarmPlatform.ProviderLimits, "Acquires a slot", $techn="acquire/release", $tags="", $link="")
Rel(SwarmPlatform.Launcher, SwarmPlatform.SessionManager, "Starts local session from plan", $techn="start(plan, policy)", $tags="", $link="")
Rel(SwarmPlatform.Launcher, SwarmPlatform.RemoteHarness, "Starts remote session", $techn="rwh run / rwh worker", $tags="", $link="")
Rel(SwarmPlatform.Launcher, SwarmPlatform.ContextManagerandBridge.ContextBridge, "Binds I/O providers", $techn="bind()", $tags="", $link="")
Rel(SwarmPlatform.Launcher, SwarmPlatform.ContextManagerandBridge.ContextManagerCore, "Restores optional context slice", $techn="restore()", $tags="", $link="")
Rel(SwarmPlatform.Launcher, SwarmPlatform.Trust, "Consumes mandate for privileged steps", $techn="mandate consume", $tags="", $link="")
Rel(SwarmPlatform.SessionManager, SwarmPlatform.AgentHarnessSession, "Holds process alive", $techn="PTY / pipes", $tags="", $link="")
Rel(SwarmPlatform.SessionManager, SwarmPlatform.ContextManagerandBridge.ContextManagerCore, "Grants I/O channel, asks for snapshot on park", $techn="channel(), snapshot()", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ContextManagerCore, SwarmPlatform.ContextManagerandBridge.HarnessAdapters, "Writes stdin, reads stdout", $techn="inject/observe", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.HarnessAdapters, SwarmPlatform.AgentHarnessSession, "Turn input and output", $techn="stream-json / app-server / PTY", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ContextManagerCore, SwarmPlatform.ContextManagerandBridge.JournalandContextStore, "Appends events, stores handoffs", $techn="append/snapshot", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ContextBridge, SwarmPlatform.ContextManagerandBridge.TrustGate, "Checks every inbound envelope", $techn="verify()", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.TrustGate, SwarmPlatform.Trust, "Verifies signatures, grants, mandates", $techn="verify/granted", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ContextBridge, SwarmPlatform.ContextManagerandBridge.ContextManagerCore, "Injects admitted envelopes, observes output", $techn="inject(lane)/observe()", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ContextBridge, SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, "Runs plugins through", $techn="JSONL", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, SwarmPlatform.ContextManagerandBridge.MatrixProvider, "bind/output/tail", $techn="", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, SwarmPlatform.ContextManagerandBridge.GoalProvider, "bind/output/tail", $techn="", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, SwarmPlatform.ContextManagerandBridge.TerminalProvider, "bind/output", $techn="", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.ProviderPluginInterface, SwarmPlatform.ContextManagerandBridge.BoardProviderfuture, "bind/output (future)", $techn="", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.TailsCLI, SwarmPlatform.ContextManagerandBridge.ContextBridge, "Goal set/clear, post, park", $techn="unix socket + session token", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, SwarmPlatform.ContextManagerandBridge.TailsCLI, "Agent runs tail commands", $techn="shell tool", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.MatrixProvider, MatrixHomeservera2a, "Subscribes and posts", $techn="a2a / Matrix CS API", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge.GoalProvider, SwarmPlatform.ProviderLimits, "Checks nudge budget", $techn="acquire()", $tags="", $link="")
Rel(SwarmPlatform.RemoteHarness, SwarmPlatform.ContextManagerandBridge.ContextManagerCore, "Relays turns and output", $techn="adapter over rwh", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml