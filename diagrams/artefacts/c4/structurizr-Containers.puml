@startuml
title <size:24>Container View: Swarm Platform</size>\n<size:24>Platform modules and supporting services</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Owner, "Owner", $descr="Sets direction, signs mandates, talks to keepers in product spaces", $tags="", $link="")
Person(Cofounderoperator, "Co-founder / operator", $descr="Runs nodes, reviews architecture, attaches to sessions", $tags="", $link="")
System(MatrixHomeservera2a, "Matrix Homeserver (a2a)", $descr="Spaces, rooms and threads; a2a mailbox and identities", $tags="", $link="")
System(ModelProviders, "Model Providers", $descr="Anthropic, OpenAI, local inference-manager endpoints", $tags="", $link="")
System(RemoteHost, "Remote Host", $descr="Mac mini with subscriptions, runs the remote harness side", $tags="", $link="")
System(GitRepositories, "Git Repositories", $descr="One repo per project", $tags="", $link="")

System_Boundary("SwarmPlatform_boundary", "Swarm Platform", $tags="") {
  Container(SwarmPlatform.AgentHarnessSession, "Agent Harness Session", $techn="Native CLI", $descr="Claude Code, Codex, Muse or Pi process in a Curator managed tool home (HOME kept)", $tags="", $link="")
  Container(SwarmPlatform.BridgeM3, "Bridge (M3)", $techn="agent-session-bridge", $descr="Hosts provider processes; trust gate; durable bridge-local admission; host enqueue; audience-checked outbox; tails", $tags="", $link="")
  Container(SwarmPlatform.Trust, "Trust", $techn="mandate CLI + library", $descr="curator-trust + mandates: exact-byte verification, grants, revocation snapshots, capability tokens; assurance mode T (mode S not claimed)", $tags="", $link="")
  Container(SwarmPlatform.RemoteExecutor, "Remote Executor", $techn="rwh", $descr="Runs a harness on another host from a pin-carrying launch intent; tools local and jailed; returns the accepted pin and plan digest", $tags="", $link="")
  Container(SwarmPlatform.WorkerJail, "Worker Jail", $techn="worker-jail + colima", $descr="One hardened container per tool call, patches out", $tags="", $link="")
  Container(SwarmPlatform.ModelRouter, "Model Router", $techn="curator-model-router", $descr="Model and effort per task class", $tags="", $link="")
  Container(SwarmPlatform.NetworkProfiles, "Network Profiles", $techn="curator-network-profiles", $descr="Egress profiles and conformance probe", $tags="", $link="")
  Container(SwarmPlatform.CapacityS3, "Capacity (S3)", $techn="extracted from task-board", $descr="Slots, per-host gates (disk, CPU idle, build lock, syspolicyd), lease transfer, validation FIFO (board part B6)", $tags="", $link="")
  Container(SwarmPlatform.ProductRegistryKeeper, "Product Registry / Keeper", $techn="curator-keeper registry", $descr="Products, projects, versioned project bindings (hosts, base, jail, egress, rooms, role bindings with slots), up after reboot", $tags="", $link="")
  Container(SwarmPlatform.EnvironmentManager, "Environment Manager", $techn="Curator + skill-registry", $descr="Role profiles, skills, MCP, command environment, managed tool homes, launch-env fragments (v3, then v4); curator playbook check", $tags="", $link="")
  Container(SwarmPlatform.Board, "Board", $techn="task-board kernel + curator-playbook", $descr="Task management with externally configured flows (Playbook.json) under kernel guards; a client of the launcher, bridge, capacity and registry; built in Phase 4", $tags="", $link="")
  Container(SwarmPlatform.Launcherthinclient, "Launcher (thin client)", $techn="curator run (canonical) / swarm launch (optional wrapper)", $descr="Launch transaction: prepare, capacity, compose, compare expect_pin, admit, start, initialize, ready, with compensation. Never reads a fragment or store content, spells a flag, execs or holds", $tags="", $link="")
  Container(SwarmPlatform.Composer, "Composer", $techn="curator-run + agents-management (one construction site)", $descr="The only composer and fragment reader: resolves the role profile, builds one Decision 0013 plan (interactive, headless, hosted-stream with session-start permission frames); compose-only and compare-only answers", $tags="", $link="")
  Container(SwarmPlatform.SessionHostM1M2, "Session Host (M1 + M2)", $techn="agent-session-host (Phase-0 baseline: tb-sessiond)", $descr="One codebase: supervisor, minimal execution holders, host-enforced admission and fences, Context Engine package, goal ledger, host-owned journal", $tags="", $link="")
}

Rel(SwarmPlatform.AgentHarnessSession, SwarmPlatform.BridgeM3, "Agent runs tail commands", $techn="shell tool", $tags="", $link="")
Rel(SwarmPlatform.BridgeM3, MatrixHomeservera2a, "Subscribes and posts", $techn="a2a / Matrix CS API", $tags="", $link="")
Rel(SwarmPlatform.BridgeM3, SwarmPlatform.CapacityS3, "Checks nudge budget", $techn="acquire()", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, ModelProviders, "Model calls", $techn="HTTPS", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, GitRepositories, "Works in project repo", $techn="git", $tags="", $link="")
Rel(SwarmPlatform.RemoteExecutor, RemoteHost, "Target curator-run composes and refuses on pin mismatch; harness turns", $techn="ssh + unix sockets", $tags="", $link="")
Rel(SwarmPlatform.RemoteExecutor, SwarmPlatform.WorkerJail, "Runs tool calls", $techn="worker-jail run", $tags="", $link="")
Rel(SwarmPlatform.RemoteExecutor, SwarmPlatform.SessionHostM1M2, "Relays turns and output", $techn="adapter over rwh", $tags="", $link="")
Rel(SwarmPlatform.WorkerJail, GitRepositories, "Seeds from the exact base SHA, exports patch", $techn="git bundle", $tags="", $link="")
Rel(RemoteHost, ModelProviders, "Model calls on remote subscriptions", $techn="HTTPS", $tags="", $link="")
Rel(SwarmPlatform.ModelRouter, ModelProviders, "Knows provider capabilities", $techn="catalog", $tags="", $link="")
Rel(SwarmPlatform.Board, GitRepositories, "Reads Playbook.json at the default-branch head", $techn="git", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.EnvironmentManager, "Validates and resolves the closure and role skills", $techn="curator playbook check", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.Trust, "Asks whether a version is confirmed or covered", $techn="confirmed/granted/narrowed", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.ProductRegistryKeeper, "Reads role bindings, pins and slots", $techn="binding()", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.Launcherthinclient, "Launches the role with the spawn key", $techn="launch(LaunchRequest)", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.BridgeM3, "Publishes goal revisions, receives outcome proposals", $techn="swarm-plugin/1", $tags="", $link="")
Rel(SwarmPlatform.Board, SwarmPlatform.CapacityS3, "Slots, gates and validation FIFO", $techn="acquire/queue", $tags="", $link="")
Rel(Owner, MatrixHomeservera2a, "Talks to keepers in product spaces", $techn="", $tags="", $link="")
Rel(Owner, SwarmPlatform.Trust, "Signs mandates, grants and authoritative envelopes", $techn="mandate CLI", $tags="", $link="")
Rel(Cofounderoperator, SwarmPlatform.Launcherthinclient, "Launches keepers and orchestrators", $techn="curator run", $tags="", $link="")
Rel(Cofounderoperator, SwarmPlatform.SessionHostM1M2, "Lists, parks, restarts; R55 binary swap in the maintenance slot", $techn="CLI (signed control)", $tags="", $link="")
Rel(Owner, SwarmPlatform.Board, "Confirms flow versions, acts in human-owned states", $techn="task-board trust confirm", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.Composer, "Asks for one plan (compose-only); compares expect_pin", $techn="curator-run, launch intent", $tags="", $link="")
Rel(SwarmPlatform.Composer, SwarmPlatform.EnvironmentManager, "Resolves the role profile (sole fragment reader)", $techn="env resolve JSON", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ModelRouter, "Routes model and effort", $techn="route()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.NetworkProfiles, "Resolves egress profile", $techn="resolve()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.CapacityS3, "Slot and per-host gates", $techn="admit_host()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ProductRegistryKeeper, "Reads the versioned project binding", $techn="binding()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.SessionHostM1M2, "Hands the composed plan to intake; drives initialize", $techn="ax start --launch-plan contract", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.RemoteExecutor, "Sends a launch intent with profile_pin and binding pin", $techn="rwh", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.BridgeM3, "Binds I/O providers at initialize", $techn="bind()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.Trust, "Consumes mandate for privileged steps", $techn="mandate consume", $tags="", $link="")
Rel(SwarmPlatform.SessionHostM1M2, SwarmPlatform.Composer, "Compare-only pin answer on resume; new plan only for rebuild", $techn="compose-only", $tags="", $link="")
Rel(SwarmPlatform.SessionHostM1M2, SwarmPlatform.CapacityS3, "Rechecks gates before exec; holds the transferred lease", $techn="admit_host/release", $tags="", $link="")
Rel(SwarmPlatform.SessionHostM1M2, SwarmPlatform.Trust, "Re-verifies grants and revocation at enqueue and dispatch", $techn="verify/granted", $tags="", $link="")
Rel(SwarmPlatform.SessionHostM1M2, SwarmPlatform.AgentHarnessSession, "Execs and holds the process", $techn="process group", $tags="", $link="")
Rel(SwarmPlatform.ProductRegistryKeeper, SwarmPlatform.SessionHostM1M2, "Requests restore after reboot (only automatic requester)", $techn="up() -> resume()", $tags="", $link="")
Rel(SwarmPlatform.BridgeM3, SwarmPlatform.Trust, "Verifies signatures, grants, mandates", $techn="verify/granted", $tags="", $link="")
Rel(SwarmPlatform.BridgeM3, SwarmPlatform.SessionHostM1M2, "Durable idempotent enqueue; acceptance after host ack", $techn="enqueue(idem_key)", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml