@startuml
title <size:24>Container View: Swarm Platform</size>\n<size:24>Platform modules and supporting services</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Owner, "Owner", $descr="Sets direction, signs mandates, talks to keepers in product spaces", $tags="", $link="")
Person(Cofounderoperator, "Co-founder / operator", $descr="Runs nodes, reviews architecture, attaches to sessions", $tags="", $link="")
System(MatrixHomeservera2a, "Matrix Homeserver (a2a)", $descr="Spaces, rooms and threads; a2a mailbox and identities", $tags="", $link="")
System(ModelProviders, "Model Providers", $descr="Anthropic, OpenAI, local inference-manager endpoints", $tags="", $link="")
System(RemoteHost, "Remote Host", $descr="Mac mini with subscriptions, runs the remote harness side", $tags="", $link="")
System(GitRepositories, "Git Repositories", $descr="One repo per project", $tags="", $link="")

System_Boundary("SwarmPlatform_boundary", "Swarm Platform", $tags="") {
  Container(SwarmPlatform.AgentHarnessSession, "Agent Harness Session", $techn="Native CLI", $descr="Claude Code, Codex, Muse or Pi process in a Curator managed tool home (HOME kept)", $tags="", $link="")
  Container(SwarmPlatform.Trust, "Trust", $techn="mandate CLI + library", $descr="Mandates, curator-trust grants, capability tokens", $tags="", $link="")
  Container(SwarmPlatform.RemoteHarness, "Remote Harness", $techn="rwh", $descr="Runs a harness on another host, tools local and jailed", $tags="", $link="")
  Container(SwarmPlatform.WorkerJail, "Worker Jail", $techn="worker-jail + colima", $descr="One hardened container per tool call, patches out", $tags="", $link="")
  Container(SwarmPlatform.ModelRouter, "Model Router", $techn="curator-model-router", $descr="Runtime, model and effort per task class", $tags="", $link="")
  Container(SwarmPlatform.NetworkProfiles, "Network Profiles", $techn="curator-network-profiles", $descr="Egress profiles and conformance probe", $tags="", $link="")
  Container(SwarmPlatform.ProviderLimits, "Provider Limits", $techn="extracted from task-board", $descr="Host semaphore, rate limits, validation FIFO for check sets (board part B6)", $tags="", $link="")
  Container(SwarmPlatform.ProductRegistryKeeper, "Product Registry / Keeper", $techn="curator-keeper registry", $descr="Products, projects, project bindings (hosts, rooms, role bindings), keeper processes, up after reboot", $tags="", $link="")
  Container(SwarmPlatform.EnvironmentManager, "Environment Manager", $techn="Curator + skill-registry", $descr="Role profiles, skills, MCP, command environment, managed tool homes, launch-env fragments (v3, then v4); curator playbook check", $tags="", $link="")
  Container(SwarmPlatform.Boardflowplugin, "Board (flow plugin)", $techn="task-board kernel + curator-playbook", $descr="Task management with externally configured flows (Playbook.json); a client of M4, M3 and S3; built in Phase 4", $tags="", $link="")
  Container(SwarmPlatform.Launcherthinclient, "Launcher (thin client)", $techn="Go CLI (swarm launch)", $descr="Turns a LaunchRequest into a launch intent: route, network, limits slot, project binding; gets one plan from the composer, hands it to M1 or M6, binds I/O and context. Never reads a fragment, spells a flag, execs or holds", $tags="", $link="")
  Container(SwarmPlatform.Composer, "Composer", $techn="curator-run + agents-management (one construction site)", $descr="The only composer and fragment reader: resolves the role profile, builds one Decision 0013 plan (interactive, headless, hosted-stream); compose-only for non-interactive modes", $tags="", $link="")
  Container(SwarmPlatform.SessionManager, "Session Manager", $techn="agent-session-host core (now: tb-sessiond)", $descr="Plan intake (ax start --launch-plan), exec and holding: process groups, abort fences, exit classification, park, restart with pin re-check, reboot restore; no content", $tags="", $link="")
  Container(SwarmPlatform.ContextManagerandBridge, "Context Manager and Bridge", $techn="Go library in the holder + bridge process", $descr="Wraps agent stdin/stdout, keeps the unified context, hosts in/out provider plugins behind a trust gate", $tags="", $link="")
}

Rel(SwarmPlatform.Boardflowplugin, GitRepositories, "Reads Playbook.json at the default-branch head", $techn="git", $tags="", $link="")
Rel(SwarmPlatform.Boardflowplugin, SwarmPlatform.EnvironmentManager, "Validates and resolves templates and role skills", $techn="curator playbook check", $tags="", $link="")
Rel(SwarmPlatform.Boardflowplugin, SwarmPlatform.Trust, "Asks whether a version is confirmed or covered", $techn="confirmed/granted/narrowed", $tags="", $link="")
Rel(SwarmPlatform.Boardflowplugin, SwarmPlatform.ProductRegistryKeeper, "Reads role bindings to standing sessions", $techn="binding()", $tags="", $link="")
Rel(SwarmPlatform.Boardflowplugin, SwarmPlatform.Launcherthinclient, "Launches the role", $techn="launch(LaunchRequest)", $tags="", $link="")
Rel(SwarmPlatform.Boardflowplugin, SwarmPlatform.ProviderLimits, "Slots and validation FIFO", $techn="acquire/queue", $tags="", $link="")
Rel(Owner, MatrixHomeservera2a, "Talks to keepers in product spaces", $techn="", $tags="", $link="")
Rel(Owner, SwarmPlatform.Trust, "Signs mandates and grants", $techn="mandate CLI", $tags="", $link="")
Rel(Cofounderoperator, SwarmPlatform.Launcherthinclient, "Launches keepers and orchestrators", $techn="swarm launch", $tags="", $link="")
Rel(Cofounderoperator, SwarmPlatform.SessionManager, "Lists, attaches, parks, restarts", $techn="CLI", $tags="", $link="")
Rel(Owner, SwarmPlatform.Boardflowplugin, "Confirms flow versions, acts in human-owned states", $techn="task-board trust confirm", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.Composer, "Asks for one plan (compose-only)", $techn="curator-run, launch intent", $tags="", $link="")
Rel(SwarmPlatform.Composer, SwarmPlatform.EnvironmentManager, "Resolves the role profile (sole fragment reader)", $techn="env resolve JSON", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ModelRouter, "Routes model and effort", $techn="route()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.NetworkProfiles, "Resolves egress profile", $techn="resolve()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ProviderLimits, "Acquires a slot", $techn="acquire/release", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ProductRegistryKeeper, "Reads project binding", $techn="binding()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.SessionManager, "Hands the composed plan to intake", $techn="ax start --launch-plan", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.RemoteHarness, "Sends a launch intent (interim: bundle from lock_sha256)", $techn="rwh run / rwh worker", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.ContextManagerandBridge, "Binds I/O providers and the goal", $techn="bind()", $tags="", $link="")
Rel(SwarmPlatform.Launcherthinclient, SwarmPlatform.Trust, "Consumes mandate for privileged steps", $techn="mandate consume", $tags="", $link="")
Rel(SwarmPlatform.SessionManager, SwarmPlatform.AgentHarnessSession, "Execs and holds the process", $techn="PTY / hosted stream", $tags="", $link="")
Rel(SwarmPlatform.SessionManager, SwarmPlatform.Composer, "Re-resolves the pin on resume, refuses drift", $techn="compose-only", $tags="", $link="")
Rel(SwarmPlatform.SessionManager, SwarmPlatform.ContextManagerandBridge, "Grants I/O channel, asks for snapshot on park", $techn="channel(), snapshot()", $tags="", $link="")
Rel(SwarmPlatform.ProductRegistryKeeper, SwarmPlatform.SessionManager, "Restores node after reboot", $techn="up() -> resume()", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge, SwarmPlatform.AgentHarnessSession, "Turn input and output", $techn="stream-json / app-server / PTY", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge, SwarmPlatform.Trust, "Verifies signatures, grants, mandates", $techn="verify/granted", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge, SwarmPlatform.Boardflowplugin, "bind/output/tail", $techn="JSONL", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, SwarmPlatform.ContextManagerandBridge, "Agent runs tail commands", $techn="shell tool", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge, MatrixHomeservera2a, "Subscribes and posts", $techn="a2a / Matrix CS API", $tags="", $link="")
Rel(SwarmPlatform.ContextManagerandBridge, SwarmPlatform.ProviderLimits, "Checks nudge budget", $techn="acquire()", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, ModelProviders, "Model calls", $techn="HTTPS", $tags="", $link="")
Rel(SwarmPlatform.AgentHarnessSession, GitRepositories, "Works in project repo", $techn="git", $tags="", $link="")
Rel(SwarmPlatform.RemoteHarness, RemoteHost, "Runs remote harness turns", $techn="ssh + unix sockets", $tags="", $link="")
Rel(SwarmPlatform.RemoteHarness, SwarmPlatform.WorkerJail, "Runs tool calls", $techn="worker-jail run", $tags="", $link="")
Rel(SwarmPlatform.RemoteHarness, SwarmPlatform.ContextManagerandBridge, "Relays turns and output", $techn="adapter over rwh", $tags="", $link="")
Rel(SwarmPlatform.WorkerJail, GitRepositories, "Seeds from landed ref, exports patch", $techn="git bundle", $tags="", $link="")
Rel(RemoteHost, ModelProviders, "Model calls on remote subscriptions", $techn="HTTPS", $tags="", $link="")
Rel(SwarmPlatform.ModelRouter, ModelProviders, "Knows provider capabilities", $techn="catalog", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml